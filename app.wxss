page {
  min-height: 100%;
  background: #f7f4ee;
  color: #252821;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
}

.eyebrow {
  color: #68715f;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-description {
  margin-top: 20rpx;
  color: #62675d;
  font-size: 30rpx;
  line-height: 1.7;
}

.placeholder-card {
  margin-top: 48rpx;
  padding: 44rpx 36rpx;
  border: 2rpx solid #e2ded4;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 14rpx 36rpx rgba(54, 58, 48, 0.06);
}

.placeholder-icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #e6ebdf;
  font-size: 42rpx;
}

.placeholder-title {
  display: block;
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.placeholder-text {
  display: block;
  margin-top: 14rpx;
  color: #73786e;
  font-size: 28rpx;
  line-height: 1.65;
}

.form-card,
.result-card {
  margin-top: 36rpx;
  padding: 34rpx 30rpx;
  border: 2rpx solid #e2ded4;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 14rpx 36rpx rgba(54, 58, 48, 0.05);
}

.form-section-title,
.result-title,
.subsection-title {
  display: block;
  font-weight: 700;
}

.form-section-title,
.result-title {
  font-size: 34rpx;
}

.form-note,
.result-note {
  display: block;
  margin-top: 12rpx;
  color: #73786e;
  font-size: 24rpx;
  line-height: 1.55;
}

.field {
  margin-top: 30rpx;
}

.field__header,
.result-heading,
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  color: #30342d;
  font-size: 28rpx;
  font-weight: 600;
}

.field__unit,
.field__optional {
  color: #8a8e85;
  font-size: 23rpx;
}

.field__input,
.selector-box {
  width: 100%;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #dcd8cf;
  border-radius: 18rpx;
  background: #fbfaf6;
  color: #252821;
  font-size: 29rpx;
}

.field__input--error {
  border-color: #b75743;
  background: #fff8f5;
}

.field__hint,
.field__error {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.field__hint {
  color: #7b8077;
}

.field__error {
  color: #a74431;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  margin: 2rpx -8rpx -8rpx;
}

.choice-chip {
  min-height: 76rpx;
  margin: 16rpx 8rpx 8rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d8d5cc;
  border-radius: 18rpx;
  background: #f8f6f0;
  color: #596057;
  font-size: 25rpx;
  line-height: 72rpx;
}

.choice-chip::after,
.primary-button::after,
.secondary-button::after,
.share-button::after,
.advanced-toggle::after {
  border: 0;
}

.choice-chip--active {
  border-color: #596b52;
  background: #e6ebdf;
  color: #344230;
  font-weight: 650;
}

.toggle-row {
  min-height: 88rpx;
  margin-top: 24rpx;
}

.toggle-row__copy {
  min-width: 0;
  padding-right: 24rpx;
}

.toggle-row__title,
.toggle-row__description {
  display: block;
}

.toggle-row__title {
  font-size: 28rpx;
  font-weight: 600;
}

.toggle-row__description {
  margin-top: 6rpx;
  color: #7c8178;
  font-size: 23rpx;
}

.subsection {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #ece8df;
}

.subsection-title {
  font-size: 29rpx;
}

.advanced-toggle {
  min-height: 78rpx;
  margin: 28rpx 0 0;
  padding: 0;
  background: transparent;
  color: #596b52;
  font-size: 26rpx;
  line-height: 78rpx;
  text-align: left;
}

.button-row {
  display: flex;
  margin-top: 36rpx;
}

.primary-button,
.secondary-button,
.share-button {
  min-height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.primary-button {
  flex: 1;
  background: #41503c;
  color: #fffdf8;
}

.secondary-button {
  width: 190rpx;
  margin-left: 18rpx;
  background: #ece9e1;
  color: #555b51;
}

.page-error {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #fff0eb;
  color: #9f3e2d;
  font-size: 25rpx;
  line-height: 1.55;
}

.result-card {
  border-color: #d4ddcc;
  background: #fbfdf8;
}

.confidence-badge {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #e2eadb;
  color: #44543e;
  font-size: 22rpx;
  font-weight: 650;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.result-item {
  min-width: 0;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #f0f3eb;
}

.result-item--primary {
  background: #dfe8d7;
}

.result-item__label,
.result-item__value,
.result-item__unit {
  display: block;
}

.result-item__label {
  color: #697066;
  font-size: 22rpx;
}

.result-item__value {
  margin-top: 10rpx;
  color: #293326;
  font-size: 38rpx;
  font-weight: 700;
  word-break: break-all;
}

.result-item__unit {
  margin-top: 4rpx;
  color: #757b71;
  font-size: 21rpx;
}

.result-detail {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #e4e9de;
}

.result-detail__title,
.result-detail__text {
  display: block;
}

.result-detail__title {
  font-size: 27rpx;
  font-weight: 650;
}

.result-detail__text {
  margin-top: 9rpx;
  color: #60685d;
  font-size: 24rpx;
  line-height: 1.55;
}

.warning-list {
  margin-top: 24rpx;
}

.warning {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #c38b39;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #78551f;
  font-size: 24rpx;
  line-height: 1.6;
}

.share-button {
  margin-top: 26rpx;
  border: 2rpx solid #9eaa98;
  background: transparent;
  color: #4a5b44;
}
