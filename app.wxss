/*
 * M3.5A shared visual foundation.
 * Presentation tokens only: spacing, typography, radius, color roles, control metrics.
 * No Calculator logic, no business value, no new class names.
 */
page {
  /* spacing scale */
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 24rpx;
  --space-5: 32rpx;
  --space-6: 48rpx;
  --space-7: 64rpx;

  /* typography scale */
  --font-caption: 22rpx;
  --font-meta: 24rpx;
  --font-body: 28rpx;
  --font-subtitle: 30rpx;
  --font-section: 34rpx;
  --font-display: 52rpx;

  /* radius scale */
  --radius-xs: 12rpx;
  --radius-sm: 18rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 34rpx;
  --radius-pill: 999rpx;

  /* surface and text roles */
  --color-canvas: #f7f4ee;
  --color-surface: #fffdf8;
  --color-surface-muted: #f8f6f0;
  --color-surface-sunken: #f0f3eb;
  --color-border: #e2ded4;
  --color-border-input: #dcd8cf;
  --color-divider: #ece8df;
  --color-text: #252821;
  --color-text-strong: #30342d;
  --color-text-secondary: #62675d;
  --color-text-muted: #8a8e85;
  --color-inverse-surface: #2f3a2d;
  --color-inverse-text: #fffdf8;

  /* accent, danger and warning roles */
  --color-accent: #41503c;
  --color-accent-text: #596b52;
  --color-accent-soft: #e6ebdf;
  --color-danger: #a74431;
  --color-danger-border: #b75743;
  --color-danger-surface: #fff0eb;
  --color-warning: #78551f;
  --color-warning-border: #c38b39;
  --color-warning-surface: #fff7e8;

  /* control metrics */
  --control-height: 88rpx;
  --control-line-height: 1.4;

  /* elevation */
  --shadow-card: 0 14rpx 36rpx rgba(54, 58, 48, 0.05);
  --shadow-card-strong: 0 14rpx 36rpx rgba(54, 58, 48, 0.06);

  min-height: 100%;
  background: var(--color-canvas);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

.page-shell {
  padding: 48rpx 32rpx 64rpx;
  padding-bottom: calc(var(--space-7) + env(safe-area-inset-bottom, 0rpx));
}

.eyebrow {
  color: #68715f;
  font-size: var(--font-meta);
  font-weight: 600;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: var(--space-3);
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.25;
}

.page-description {
  margin-top: 20rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-subtitle);
  line-height: 1.7;
}

.placeholder-card {
  margin-top: var(--space-6);
  padding: 44rpx 36rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.placeholder-icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--color-accent-soft);
  font-size: 42rpx;
}

.placeholder-title {
  display: block;
  margin-top: var(--space-5);
  font-size: var(--font-section);
  font-weight: 650;
}

.placeholder-text {
  display: block;
  margin-top: 14rpx;
  color: #73786e;
  font-size: var(--font-body);
  line-height: 1.65;
}

.form-card,
.result-card {
  margin-top: 36rpx;
  padding: 34rpx 30rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.form-section-title,
.result-title,
.subsection-title {
  display: block;
  font-weight: 700;
}

.form-section-title,
.result-title {
  font-size: var(--font-section);
}

.form-note,
.result-note {
  display: block;
  margin-top: var(--space-2);
  color: #73786e;
  font-size: var(--font-meta);
  line-height: 1.55;
}

.field {
  margin-top: 30rpx;
}

.field__header,
.result-heading,
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.field__label {
  min-width: 0;
  color: var(--color-text-strong);
  font-size: var(--font-body);
  font-weight: 600;
}

.field__unit,
.field__optional {
  color: var(--color-text-muted);
  font-size: var(--font-meta);
}

.field__input,
.selector-box {
  width: 100%;
  min-height: var(--control-height);
  margin-top: 14rpx;
  padding: 20rpx var(--space-4);
  border: 2rpx solid var(--color-border-input);
  border-radius: var(--radius-sm);
  background: #fbfaf6;
  color: var(--color-text);
  font-size: 29rpx;
}

.field__input--error {
  border-color: var(--color-danger-border);
  background: #fff8f5;
}

.field__hint,
.field__error {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.field__hint {
  color: #7b8077;
}

.field__error {
  color: var(--color-danger);
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  margin: 2rpx -8rpx -8rpx;
}

.choice-chip {
  display: flex;
  min-height: var(--control-height);
  align-items: center;
  justify-content: center;
  margin: var(--space-3) var(--space-1) var(--space-1);
  padding: var(--space-2) var(--space-4);
  border: 2rpx solid #d8d5cc;
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  color: #596057;
  font-size: 25rpx;
  line-height: var(--control-line-height);
  white-space: normal;
  text-align: center;
}

.choice-chip::after,
.primary-button::after,
.secondary-button::after,
.share-button::after,
.advanced-toggle::after {
  border: 0;
}

.choice-chip--active {
  border-color: var(--color-accent-text);
  background: var(--color-accent-soft);
  color: #344230;
  font-weight: 650;
}

.toggle-row {
  min-height: var(--control-height);
  margin-top: var(--space-4);
}

.toggle-row__copy {
  min-width: 0;
  padding-right: var(--space-4);
}

.toggle-row__title,
.toggle-row__description {
  display: block;
}

.toggle-row__title {
  font-size: var(--font-body);
  font-weight: 600;
}

.toggle-row__description {
  margin-top: 6rpx;
  color: #7c8178;
  font-size: 23rpx;
}

.subsection {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--color-divider);
}

.subsection-title {
  font-size: 29rpx;
}

.advanced-toggle {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: flex-start;
  margin: 28rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--color-accent-text);
  font-size: 26rpx;
  line-height: var(--control-line-height);
  text-align: left;
}

.button-row {
  display: flex;
  margin-top: 36rpx;
}

.primary-button,
.secondary-button,
.share-button {
  display: flex;
  min-height: var(--control-height);
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  font-weight: 650;
  line-height: var(--control-line-height);
  white-space: normal;
  text-align: center;
}

.primary-button {
  flex: 1;
  background: var(--color-accent);
  color: var(--color-inverse-text);
}

.secondary-button {
  width: 190rpx;
  margin-left: 18rpx;
  background: #ece9e1;
  color: #555b51;
}

.page-error {
  margin-top: 22rpx;
  padding: 22rpx var(--space-4);
  border-radius: 16rpx;
  background: var(--color-danger-surface);
  color: #9f3e2d;
  font-size: 25rpx;
  line-height: 1.55;
}

.result-card {
  border-color: #d4ddcc;
  background: #fbfdf8;
}

.confidence-badge {
  flex: 0 0 auto;
  padding: 9rpx var(--space-3);
  border-radius: var(--radius-pill);
  background: #e2eadb;
  color: #44543e;
  font-size: var(--font-caption);
  font-weight: 650;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.result-item {
  min-width: 0;
  padding: 22rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface-sunken);
}

.result-item--primary {
  background: #dfe8d7;
}

.result-item__label,
.result-item__value,
.result-item__unit {
  display: block;
}

.result-item__label {
  color: #697066;
  font-size: var(--font-caption);
}

.result-item__value {
  margin-top: 10rpx;
  color: #293326;
  font-size: 38rpx;
  font-weight: 700;
  word-break: break-all;
}

.result-item__unit {
  margin-top: 4rpx;
  color: #757b71;
  font-size: 21rpx;
}

.result-detail {
  margin-top: var(--space-4);
  padding-top: 22rpx;
  border-top: 2rpx solid #e4e9de;
}

.result-detail__title,
.result-detail__text {
  display: block;
}

.result-detail__title {
  font-size: 27rpx;
  font-weight: 650;
}

.result-detail__text {
  margin-top: 9rpx;
  color: #60685d;
  font-size: var(--font-meta);
  line-height: 1.55;
}

.warning-list {
  margin-top: var(--space-4);
}

.warning {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid var(--color-warning-border);
  border-radius: var(--radius-xs);
  background: var(--color-warning-surface);
  color: var(--color-warning);
  font-size: var(--font-meta);
  line-height: 1.6;
}

.share-button {
  margin-top: 26rpx;
  border: 2rpx solid #9eaa98;
  background: transparent;
  color: #4a5b44;
}
