.home-page {
  min-height: 100vh;
  padding: 36rpx 28rpx 56rpx;
}

.hero {
  padding: 48rpx 36rpx 52rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #2f3a2d;
  color: #fffdf8;
  box-shadow: 0 18rpx 44rpx rgba(43, 52, 40, 0.17);
}

.hero__eyebrow,
.hero__title,
.hero__description {
  display: block;
}

.hero__eyebrow {
  color: #ccd8bf;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.hero__title {
  margin-top: 26rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero__description {
  max-width: 560rpx;
  margin-top: 20rpx;
  color: #e2e7dd;
  font-size: 28rpx;
  line-height: 1.65;
}

.tool-section {
  margin-top: 48rpx;
}

.tool-section--more {
  margin-top: 52rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-heading__title {
  font-size: 36rpx;
  font-weight: 700;
}

.section-heading__count {
  color: #858a80;
  font-size: 24rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.tool-card {
  min-height: 320rpx;
  padding: 30rpx 26rpx;
  border: 2rpx solid #e3dfd5;
  border-radius: 26rpx;
  background: #fffdf8;
  transition: transform 120ms ease, background-color 120ms ease;
}

.tool-card--pressed {
  background: #f1eee6;
  transform: scale(0.98);
}

.tool-card__icon,
.more-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6ebdf;
  color: #41503c;
  font-weight: 700;
}

.tool-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.tool-card__name,
.tool-card__description,
.tool-card__link {
  display: block;
}

.tool-card__name {
  margin-top: 26rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.tool-card__description {
  min-height: 76rpx;
  margin-top: 12rpx;
  color: #74796f;
  font-size: 24rpx;
  line-height: 1.55;
}

.tool-card__link {
  margin-top: 22rpx;
  color: #596b52;
  font-size: 24rpx;
  font-weight: 600;
}

.more-list {
  overflow: hidden;
  border: 2rpx solid #e3dfd5;
  border-radius: 26rpx;
  background: #fffdf8;
}

.more-card {
  display: flex;
  min-height: 148rpx;
  align-items: center;
  padding: 26rpx 28rpx;
}

.more-card + .more-card {
  border-top: 2rpx solid #ece8df;
}

.more-card--pressed {
  background: #f1eee6;
}

.more-card__icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  border-radius: 19rpx;
  font-size: 26rpx;
}

.more-card__content {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.more-card__name,
.more-card__description {
  display: block;
}

.more-card__name {
  font-size: 29rpx;
  font-weight: 650;
}

.more-card__description {
  margin-top: 9rpx;
  color: #7a7f75;
  font-size: 23rpx;
  line-height: 1.45;
}

.more-card__arrow {
  margin-left: 20rpx;
  color: #92978d;
  font-size: 44rpx;
  font-weight: 300;
}

.home-footer {
  display: block;
  margin-top: 48rpx;
  color: #9a9d95;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-align: center;
}
