.home-page {
  padding: 36rpx 28rpx 56rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom, 0rpx));
}

.hero {
  padding: 48rpx 36rpx 52rpx;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background: var(--color-inverse-surface);
  color: var(--color-inverse-text);
  box-shadow: 0 18rpx 44rpx rgba(43, 52, 40, 0.17);
}

.hero__eyebrow,
.hero__title,
.hero__description {
  display: block;
}

.hero__eyebrow {
  color: #ccd8bf;
  font-size: var(--font-caption);
  font-weight: 700;
  letter-spacing: 6rpx;
}

.hero__title {
  margin-top: 26rpx;
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.25;
}

.hero__description {
  max-width: 560rpx;
  margin-top: 20rpx;
  color: #e2e7dd;
  font-size: var(--font-body);
  line-height: 1.65;
}

.tool-section {
  margin-top: var(--space-6);
}

.tool-section--more {
  margin-top: 52rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-4);
  padding: 0 4rpx;
}

.section-heading__title {
  font-size: var(--font-section);
  font-weight: 700;
}

.section-heading__count {
  flex: 0 0 auto;
  margin-left: var(--space-2);
  color: #858a80;
  font-size: var(--font-meta);
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.tool-card {
  display: flex;
  min-height: 300rpx;
  flex-direction: column;
  padding: var(--space-5) var(--space-4);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  transition: transform 120ms ease, background-color 120ms ease;
}

.tool-card--pressed {
  background: #f1eee6;
  transform: scale(0.98);
}

.tool-card__body {
  min-width: 0;
  flex: 1;
}

.tool-card__icon,
.more-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent-soft);
  color: var(--color-accent);
  font-weight: 700;
}

.tool-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
}

.tool-card__name,
.tool-card__description,
.tool-card__link {
  display: block;
}

.tool-card__name {
  margin-top: 26rpx;
  font-size: var(--font-subtitle);
  font-weight: 650;
}

.tool-card__description {
  margin-top: var(--space-2);
  color: #74796f;
  font-size: var(--font-meta);
  line-height: 1.55;
}

.tool-card__link {
  margin-top: var(--space-4);
  color: var(--color-accent-text);
  font-size: var(--font-meta);
  font-weight: 600;
}

.more-list {
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.more-card {
  display: flex;
  min-height: 148rpx;
  align-items: center;
  padding: var(--space-4);
}

.more-card + .more-card {
  border-top: 2rpx solid var(--color-divider);
}

.more-card--pressed {
  background: #f1eee6;
}

.more-card__icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
}

.more-card__content {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-4);
}

.more-card__name,
.more-card__description {
  display: block;
}

.more-card__name {
  font-size: var(--font-subtitle);
  font-weight: 650;
}

.more-card__description {
  margin-top: 9rpx;
  color: #7a7f75;
  font-size: var(--font-meta);
  line-height: 1.45;
}

.more-card__arrow {
  flex: 0 0 auto;
  margin-left: 20rpx;
  color: #92978d;
  font-size: 44rpx;
  font-weight: 300;
}

.home-footer {
  display: block;
  margin-top: var(--space-6);
  color: #9a9d95;
  font-size: var(--font-caption);
  letter-spacing: 2rpx;
  text-align: center;
}
