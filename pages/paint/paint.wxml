<view class="page-shell">
  <text class="eyebrow">材料用量</text>
  <view class="page-title">乳胶漆用量</view>
  <view class="page-description">估算墙面与顶面的底漆、面漆用量。</view>

  <view class="form-card">
    <text class="form-section-title">选择计算方式</text>
    <view class="choice-row mode-choice-row">
      <button wx:for="{{modeOptions}}" wx:key="value" class="choice-chip {{form.mode === item.value ? 'choice-chip--active' : ''}}" data-value="{{item.value}}" bindtap="selectMode">{{item.label}}</button>
    </view>

    <view wx:if="{{form.mode === 'direct'}}" class="field">
      <view class="field__header">
        <text class="field__label">净涂刷面积</text>
        <text class="field__unit">㎡</text>
      </view>
      <input class="field__input {{fieldErrors.paintAreaM2 ? 'field__input--error' : ''}}" type="digit" value="{{form.paintAreaM2}}" placeholder="墙面与顶面实际涂刷面积" data-field="paintAreaM2" bindinput="onInput" />
      <text wx:if="{{fieldErrors.paintAreaM2}}" class="field__error">{{fieldErrors.paintAreaM2}}</text>
    </view>

    <view wx:if="{{form.mode === 'assisted'}}" class="assisted-fields">
      <view class="field">
        <view class="field__header"><text class="field__label">房间周长</text><text class="field__unit">m</text></view>
        <input class="field__input {{fieldErrors.perimeterM ? 'field__input--error' : ''}}" type="digit" value="{{form.perimeterM}}" placeholder="例如 20" data-field="perimeterM" bindinput="onInput" />
        <text wx:if="{{fieldErrors.perimeterM}}" class="field__error">{{fieldErrors.perimeterM}}</text>
      </view>
      <view class="field">
        <view class="field__header"><text class="field__label">墙面高度</text><text class="field__unit">m</text></view>
        <input class="field__input {{fieldErrors.heightM ? 'field__input--error' : ''}}" type="digit" value="{{form.heightM}}" placeholder="例如 2.8" data-field="heightM" bindinput="onInput" />
        <text wx:if="{{fieldErrors.heightM}}" class="field__error">{{fieldErrors.heightM}}</text>
      </view>
      <view class="field">
        <view class="field__header"><text class="field__label">门窗洞口面积</text><text class="field__unit">㎡</text></view>
        <input class="field__input {{fieldErrors.openingsAreaM2 ? 'field__input--error' : ''}}" type="digit" value="{{form.openingsAreaM2}}" placeholder="没有可填写 0" data-field="openingsAreaM2" bindinput="onInput" />
        <text wx:if="{{fieldErrors.openingsAreaM2}}" class="field__error">{{fieldErrors.openingsAreaM2}}</text>
      </view>

      <view class="toggle-row">
        <view class="toggle-row__copy">
          <text class="toggle-row__title">计算顶面</text>
          <text class="toggle-row__description">开启后填写顶面涂刷面积</text>
        </view>
        <switch checked="{{form.includeCeiling}}" color="#596b52" bindchange="onCeilingChange" />
      </view>

      <view wx:if="{{form.includeCeiling}}" class="field ceiling-field">
        <view class="field__header"><text class="field__label">顶面面积</text><text class="field__unit">㎡</text></view>
        <input class="field__input {{fieldErrors.ceilingAreaM2 ? 'field__input--error' : ''}}" type="digit" value="{{form.ceilingAreaM2}}" placeholder="例如 25" data-field="ceilingAreaM2" bindinput="onInput" />
        <text wx:if="{{fieldErrors.ceilingAreaM2}}" class="field__error">{{fieldErrors.ceilingAreaM2}}</text>
      </view>
    </view>

    <button class="advanced-toggle" bindtap="toggleAdvanced">{{advancedCollapsed ? '展开面漆高级参数' : '收起面漆高级参数'}}</button>

    <view wx:if="{{!advancedCollapsed}}" class="subsection advanced-fields">
      <text class="subsection-title">面漆高级参数</text>
      <text class="form-note">底漆参数保持固定，不开放调整。</text>
      <view class="field">
        <view class="field__header"><text class="field__label">覆盖率</text><text class="field__unit">㎡/L/遍</text></view>
        <input class="field__input {{fieldErrors.coverageM2PerLPerCoat ? 'field__input--error' : ''}}" type="digit" value="{{form.coverageM2PerLPerCoat}}" placeholder="10 至 16" data-field="coverageM2PerLPerCoat" bindinput="onInput" />
        <text wx:if="{{fieldErrors.coverageM2PerLPerCoat}}" class="field__error">{{fieldErrors.coverageM2PerLPerCoat}}</text>
      </view>
      <view class="field">
        <view class="field__header"><text class="field__label">面漆遍数</text><text class="field__unit">遍</text></view>
        <input class="field__input {{fieldErrors.coatCount ? 'field__input--error' : ''}}" type="digit" value="{{form.coatCount}}" placeholder="1 至 3" data-field="coatCount" bindinput="onInput" />
        <text wx:if="{{fieldErrors.coatCount}}" class="field__error">{{fieldErrors.coatCount}}</text>
      </view>
      <view class="field">
        <view class="field__header"><text class="field__label">面漆预留</text><text class="field__unit">%</text></view>
        <input class="field__input {{fieldErrors.reservePercent ? 'field__input--error' : ''}}" type="digit" value="{{form.reservePercent}}" placeholder="0 至 20" data-field="reservePercent" bindinput="onInput" />
        <text wx:if="{{fieldErrors.reservePercent}}" class="field__error">{{fieldErrors.reservePercent}}</text>
      </view>
    </view>

    <view class="button-row">
      <button class="primary-button" bindtap="calculate">计算用量</button>
      <button class="secondary-button" bindtap="reset">重置</button>
    </view>
    <view wx:if="{{pageError}}" class="page-error">{{pageError}}</view>
  </view>

  <view wx:if="{{hasCalculated}}" class="result-card">
    <view class="result-heading">
      <text class="result-title">计算结果</text>
      <text class="confidence-badge">{{displayResult.confidence}}</text>
    </view>
    <view class="result-grid">
      <view class="result-item"><text class="result-item__label">净涂刷面积</text><text class="result-item__value">{{displayResult.paintAreaM2}}</text><text class="result-item__unit">㎡</text></view>
      <view class="result-item result-item--primary"><text class="result-item__label">面漆用量</text><text class="result-item__value">{{displayResult.facePaintLiters}}</text><text class="result-item__unit">L</text></view>
      <view class="result-item result-item--primary"><text class="result-item__label">底漆用量</text><text class="result-item__value">{{displayResult.primerLiters}}</text><text class="result-item__unit">L</text></view>
    </view>
    <view wx:if="{{displayResult.hasAssistedAreas}}" class="result-detail">
      <text class="result-detail__title">面积计算明细</text>
      <text class="result-detail__text">墙面总面积 {{displayResult.grossWallAreaM2}} ㎡ · 扣除洞口后 {{displayResult.wallNetArea}} ㎡</text>
    </view>
    <text class="result-note">底漆和面漆分别展示，实际包装规格请以产品说明为准。</text>
    <button class="share-button" open-type="share">分享这个工具</button>
  </view>
</view>
